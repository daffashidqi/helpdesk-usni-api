          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"KEUANGAN\",\n  \"name\": \"Tim Keuangan\"\n}" },
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] },
            "description": "Khusus ADMIN. Role baru di luar 5 role bawaan hanya berperilaku seperti PELAPOR di ticketing engine (lihat README)."
