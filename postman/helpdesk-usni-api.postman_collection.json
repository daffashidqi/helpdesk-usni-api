    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('ticketId', pm.response.json().ticket.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Wifi lambat di lab 3", "type": "text" },
                { "key": "description", "value": "Koneksi wifi sangat lambat sejak pagi ini di lab 3", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "urgency", "value": "HIGH", "type": "text" },
                { "key": "attachments", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] },
            "description": "Login sebagai PELAPOR (atau role lain) dulu. Field attachments opsional, bisa dikosongkan/dihapus."
          },
          "response": []
        },
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "divisionId", "value": "", "disabled": true },
                { "key": "categoryId", "value": "", "disabled": true },
                { "key": "urgency", "value": "", "disabled": true },
                { "key": "assignedToId", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "description": "Filter otomatis by role: PELAPOR hanya tiketnya sendiri, agen hanya tiket divisinya, ADMIN semua."
          },
          "response": []
        },
        {
          "name": "Get Ticket Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] }
          },
          "response": []
        },
        {
          "name": "Assign Ticket to Me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "assign"] },
            "description": "Login sebagai agen IT/AKADEMIK/BUSP di divisi yang sama dengan tiket. Tiket harus berstatus OPEN."
          },
          "response": []
        },
        {
          "name": "Reassign Division",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"newCategoryId\": \"{{categoryId}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/reassign-division",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "reassign-division"]
            }
          },
          "response": []
        },
        {
          "name": "Update Status -> IN_PROGRESS/PENDING/RESOLVED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"RESOLVED\"\n}" },
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "status"] },
            "description": "Login sebagai agen pemilik divisi tiket. Lihat docs/API.md untuk state machine lengkap."
          },
          "response": []
        },
        {
