    {
      "name": "Master Data - Roles",
      "item": [
        {
          "name": "List Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const roles = pm.response.json().roles;",
                  "  const pelapor = roles.find(r => r.code === 'PELAPOR');",
                  "  if (pelapor) pm.environment.set('pelaporRoleId', pelapor.id);",
                  "  const it = roles.find(r => r.code === 'IT');",
                  "  if (it) pm.environment.set('itRoleId', it.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          },
          "response": []
        },
        {
