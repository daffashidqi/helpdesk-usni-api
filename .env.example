DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_usni?schema=public"

JWT_ACCESS_SECRET="change-this-access-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"

# Domain frontend Next.js untuk CORS (tanpa trailing slash)
FRONTEND_URL="http://localhost:3000"

# SMTP kampus untuk pengiriman email verifikasi & reset password
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Helpdesk USNI <no-reply@usni.ac.id>"

# Port server (opsional)
PORT=4000

# Set "production" di deployment agar cookie refresh token diberi flag Secure
NODE_ENV="development"

# Lampiran tiket disimpan di local disk (struktur mudah dipindah ke S3/MinIO nanti)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Kredensial admin default untuk prisma/seed.ts (opsional, ada fallback di script)
SEED_ADMIN_EMAIL="admin@usni.ac.id"
SEED_ADMIN_PASSWORD="Admin12345"

# Google reCAPTCHA v2 (checkbox) untuk halaman registrasi.
# Dapatkan pasangan site key/secret key di https://www.google.com/recaptcha/admin
# Kosongkan RECAPTCHA_SECRET_KEY untuk menonaktifkan verifikasi captcha (mis. saat dev lokal).
RECAPTCHA_SECRET_KEY=""
